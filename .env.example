# Shared configuration. Copy to .env and pass it explicitly to Compose.
# Keep the existing Nextcloud hostname; do not include a scheme or path.
DOMAIN_NAME=family.cloud
# Reserve this LAN IPv4 address for the Docker host in your router.
HOST_IP=192.168.1.10

# Loopback-only UI ports used by both Caddy and the VPN stack.
PIHOLE_UI_PORT=5353
WG_UI_PORT=51821

# Docker network; must not overlap LAN or WireGuard client subnets.
DOCKER_SUBNET=10.42.42.0/24
DOCKER_IPV6_SUBNET=fdcc:ad94:bacf:61a3::/64
WG_CONTAINER_IP=10.42.42.42
WG_CONTAINER_IPV6=fdcc:ad94:bacf:61a3::2a
PIHOLE_IP=10.42.42.3
